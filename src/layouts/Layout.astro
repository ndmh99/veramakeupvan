---
import { ClientRouter } from 'astro:transitions';
import { GA_MEASUREMENT_ID } from '../config/analytics';
import '../styles/style.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/400-italic.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/500-italic.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  preloadImage?: string;
}

const { 
  title = "Sophisticated Bridal & Editorial Makeup Artist | Vancouver, BC",
  description = "Vera Makeup Studio provides professional, luxury makeup services specializing in bridal, editorial, and special event makeup across Metro Vancouver, Canada.",
  image = "https://veramakeupvan.com/assets/images/thumbnail.jpg",
  type = "website",
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://veramakeupvan.com");

const pageNames: Record<string, string> = {
    '/about/': 'About',
    '/blog/': 'Blog',
    '/contact/': 'Contact',
    '/portfolio/': 'Portfolio',
    '/privacy/': 'Privacy Policy',
    '/terms/': 'Terms of Service',
};
const breadcrumbName = pageNames[Astro.url.pathname];

// GA4 inline script (built in frontmatter so the Measurement ID interpolates reliably)
const gaScript = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}', { anonymize_ip: true });

// The site uses Astro view transitions (client-side navigation),
// so GA4 doesn't fire page_view automatically on page changes.
// Send one manually after each navigation (skipping the first load,
// which gtag('config') already reports).
let __firstPageLoad = true;
document.addEventListener('astro:page-load', () => {
    if (__firstPageLoad) { __firstPageLoad = false; return; }
    gtag('event', 'page_view', {
        page_title: document.title,
        page_location: location.href,
        page_path: location.pathname
    });
});

// Vera's booking funnel: text-to-book (sms:), email, and forms.
// Track every one as a "booking_start" event so you can see which
// campaign (UTM) actually drives inquiries.
document.addEventListener('click', (e) => {
    const el = e.target && e.target.closest ? e.target.closest('a') : null;
    if (!el || !el.href) return;
    if (el.href.startsWith('sms:')) gtag('event', 'booking_start', { method: 'sms' });
    else if (el.href.startsWith('mailto:')) gtag('event', 'booking_start', { method: 'email' });
});
document.addEventListener('submit', (e) => {
    if (e.target && e.target.matches && e.target.matches('form')) {
        gtag('event', 'booking_start', { method: 'form' });
    }
});

// Load gtag.js only after the page is interactive so analytics never
// blocks the critical rendering path. The gtag() stub above queues
// every event, so nothing is lost while the real script is pending.
const loadGtag = () => {
    if (document.getElementById('ga-script')) return;
    const s = document.createElement('script');
    s.id = 'ga-script';
    s.src = 'https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}';
    s.async = true;
    document.body.appendChild(s);
};
if ('requestIdleCallback' in window) {
    requestIdleCallback(loadGtag, { timeout: 2500 });
} else {
    window.addEventListener('load', loadGtag);
}
// Failsafe so analytics always loads even if idle/load stalls.
setTimeout(loadGtag, 4000);
`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {breadcrumbName && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://veramakeupvan.com/" },
                { "@type": "ListItem", "position": 2, "name": breadcrumbName, "item": canonicalURL.href }
            ]
        })} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Vera Makeup Studio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage} imagesizes="100vw" fetchpriority="high" />}
    <link rel="preload" as="style" href="/css/bootstrap-icons.css" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/css/bootstrap-icons.css"></noscript>

    <!-- Google Analytics 4 (production only) -->
    {import.meta.env.PROD && (
        <script is:inline set:html={gaScript} />
    )}

</head>
<body class="bg-alabaster text-neutral-800 font-sans selection:bg-rosegold selection:text-white overflow-x-clip">
    <slot />
    
    <script is:inline>
        // Simple reveal animation on scroll
        const setupObserver = () => {
            const observerOptions = {
                threshold: 0.1
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, observerOptions);

            document.querySelectorAll('section').forEach(section => {
                section.classList.add('reveal-up');
                observer.observe(section);
            });

            // Add 'active' to hero immediately
            const hero = document.querySelector('.hero');
            if (hero) hero.classList.add('active');
            else {
                const firstSection = document.querySelector('section');
                if(firstSection) firstSection.classList.add('active');
            }
        };

        document.addEventListener('astro:page-load', setupObserver);
    </script>
    <script is:inline>
        // Chat widget loads off the critical path, on first user interaction or scroll
        const loadChatWidget = () => {
            if (document.getElementById('chat-widget-script')) return;
            const s = document.createElement('script');
            s.id = 'chat-widget-script';
            s.src = 'https://platform.simplebotinstall.com/w/chat_plugin.js';
            s.async = true;
            s.setAttribute('data-bot-id', '5829');
            document.body.appendChild(s);
            ['scroll', 'touchstart', 'click'].forEach((ev) => window.removeEventListener(ev, loadChatWidget));
        };
        ['scroll', 'touchstart', 'click'].forEach((ev) => window.addEventListener(ev, loadChatWidget, { once: true, passive: true }));
    </script>
</body>
</html>