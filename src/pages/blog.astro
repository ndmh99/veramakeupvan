---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_MEDIA } from '../config/media.ts';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const categories = [...new Set(blogPosts.map((post) => post.data.category))];
const INSTAGRAM_URL = 'https://www.instagram.com/veramakeupvan';
---

<Layout 
    title="Vera's Makeup Blog | Beauty Tips, Tutorials & Inspiration"
    description="Read the latest beauty tips, makeup tutorials, and behind-the-scenes moments from Vera Makeup Studio in Vancouver, BC."
    type="website"
>
    <Header />
    
<main class="pt-24 bg-alabaster">
    <div class="max-w-7xl mx-auto px-5 py-16">

        <!-- MASTHEAD -->
        <div class="text-center mb-16">
            <p class="text-xs tracking-[0.3em] uppercase text-taupe font-medium mb-4">Beauty Journal</p>
            <h1 class="font-serif text-4xl lg:text-5xl text-neutral-900">Vera's Blog</h1>
            <p class="mt-4 text-neutral-500 max-w-xl mx-auto">Tutorials, tips, and behind-the-scenes moments. Follow my creative process and get inspired for your next look.</p>
        </div>

        <!-- RECENT VIDEOS -->
        <section aria-labelledby="videos-heading" class="mb-20">
            <div class="flex items-end justify-between gap-6 mb-8 max-w-5xl mx-auto">
                <div>
                    <p class="text-xs tracking-[0.3em] uppercase text-taupe font-medium mb-2">Watch</p>
                    <h2 id="videos-heading" class="font-serif text-2xl lg:text-3xl text-neutral-900">Recent Videos</h2>
                </div>
                <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-2 text-sm font-medium text-rose hover:text-roseDeep transition-colors">
                    Follow on Instagram <i class="bi bi-instagram" aria-hidden="true"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
                {SITE_MEDIA.blog.posts.map((item) => (
                <article class="bg-white border border-neutral-200 rounded-sm group hover-lift luxury-shadow">
                    <div class="flex items-center justify-between p-4 border-b border-neutral-200">
                        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="flex items-center gap-3">
                            <img src={SITE_MEDIA.brand.profilePic} class="w-8 h-8 rounded-full object-cover" alt="Vera Makeup profile picture" />
                            <span class="font-bold text-sm flex items-center gap-1 hover:text-roseDeep transition-colors">
                                veramakeupvan
                                <i class="bi bi-patch-check-fill text-blue-500 text-xs" aria-hidden="true"></i>
                            </span>
                        </a>
                        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="View on Instagram" class="text-neutral-500 hover:text-neutral-900 transition-colors">
                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                        </a>
                    </div>
                    <div class="relative bg-neutral-100">
                        <video controls playsinline preload="metadata" class="w-full">
                            <source src={item.videoUrl} type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                    <div class="p-4">
                        <div class="flex justify-between items-center mb-3">
                            <div class="flex gap-4 text-2xl text-neutral-800">
                                <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Like on Instagram" class="hover:text-roseDeep hover:scale-110 transition-all"><i class="bi bi-heart" aria-hidden="true"></i></a>
                                <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Comment on Instagram" class="hover:text-roseDeep hover:scale-110 transition-all"><i class="bi bi-chat" aria-hidden="true"></i></a>
                                <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Share on Instagram" class="hover:text-roseDeep hover:scale-110 transition-all"><i class="bi bi-send" aria-hidden="true"></i></a>
                            </div>
                            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Save on Instagram" class="text-2xl text-neutral-800 hover:text-roseDeep hover:scale-110 transition-all"><i class="bi bi-bookmark" aria-hidden="true"></i></a>
                        </div>
                        <p class="font-bold text-sm mb-2">{item.likes} likes</p>
                        <p class="text-sm mb-2">
                            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="font-bold hover:text-roseDeep transition-colors">veramakeupvan</a> {item.caption}
                        </p>
                        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="text-sm text-neutral-500 mb-2 inline-block hover:text-rose transition-colors">{item.commentsLabel}</a>
                        <p class="text-xs text-neutral-400 uppercase tracking-wide">{item.timeAgo}</p>
                    </div>
                </article>
                ))}
            </div>
        </section>

        <!-- BLOG ARTICLES -->
        <section aria-labelledby="articles-heading">
            <div class="text-center mb-10">
                <p class="text-xs tracking-[0.3em] uppercase text-taupe font-medium mb-3">Read</p>
                <h2 id="articles-heading" class="font-serif text-3xl lg:text-4xl text-neutral-900">Latest From the Blog</h2>
                <p class="mt-3 text-neutral-500 max-w-xl mx-auto">Guides, tips, and inspiration for your wedding day beauty.</p>
            </div>

            <div id="blog-filters" class="flex flex-wrap justify-center gap-2 mb-12" role="group" aria-label="Filter articles by category">
                <button type="button" data-filter="all" aria-pressed="true" aria-controls="blog-grid" class="filter-chip filter-chip-active px-4 py-2 rounded-full text-xs uppercase tracking-widest font-medium">All</button>
                {categories.map((category) => (
                    <button type="button" data-filter={category} aria-pressed="false" aria-controls="blog-grid" class="filter-chip px-4 py-2 rounded-full text-xs uppercase tracking-widest font-medium">{category}</button>
                ))}
            </div>

            <div id="blog-grid" aria-live="polite" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto">
                {blogPosts.map((post) => (
                <a href={`/blog/${post.id}/`} data-category={post.data.category} aria-label={post.data.title} class="blog-card group bg-white border border-neutral-200 rounded-sm flex flex-col overflow-hidden hover-lift luxury-shadow hover:border-rosegold transition-colors">
                    <div class="relative overflow-hidden">
                        <img src={post.data.coverImage} alt={post.data.coverAlt} class="w-full aspect-[4/3] object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                        <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[10px] uppercase tracking-[0.2em] text-taupe font-medium px-3 py-1 rounded-sm">{post.data.category}</span>
                    </div>
                    <div class="p-6 flex flex-col flex-1">
                        <p class="text-xs uppercase tracking-widest text-neutral-400 mb-3">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
                        <h3 class="font-serif text-xl text-neutral-900 leading-snug mb-3 group-hover:text-roseDeep transition-colors">{post.data.title}</h3>
                        <p class="text-sm text-neutral-500 leading-relaxed mb-6 line-clamp-3">{post.data.excerpt}</p>
                        <span class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-rose group-hover:text-roseDeep transition-colors">
                            Read More <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
                        </span>
                    </div>
                </a>
                ))}
            </div>

            <p id="blog-empty" class="hidden text-center text-neutral-500 py-12">No articles in this category yet — check back soon.</p>
        </section>
        
    </div>
</main>

    <Footer />

<script is:inline>
    document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('video').forEach(video => video.load());

        const chips = Array.from(document.querySelectorAll('#blog-filters [data-filter]'));
        const cards = Array.from(document.querySelectorAll('#blog-grid [data-category]'));
        const empty = document.getElementById('blog-empty');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let active = 'all';

        if (!chips.length || !cards.length) return;

        const showFiltered = () => {
            let visible = 0;
            cards.forEach((card) => {
                const show = active === 'all' || card.dataset.category === active;
                card.classList.toggle('hidden', !show);
                if (show) visible += 1;
            });
            if (empty) empty.classList.toggle('hidden', visible > 0);
        };

        const applyFilter = (next) => {
            if (next === active) return;
            active = next;
            chips.forEach((chip) => {
                const isActive = chip.dataset.filter === active;
                chip.classList.toggle('filter-chip-active', isActive);
                chip.setAttribute('aria-pressed', String(isActive));
            });
            if (reduceMotion) {
                showFiltered();
                return;
            }
            cards.forEach((card) => card.classList.add('card-exit'));
            window.setTimeout(() => {
                showFiltered();
                requestAnimationFrame(() => {
                    cards.forEach((card) => card.classList.remove('card-exit'));
                });
            }, 200);
        };

        chips.forEach((chip) => chip.addEventListener('click', () => applyFilter(chip.dataset.filter)));
    });
</script>

</Layout>
