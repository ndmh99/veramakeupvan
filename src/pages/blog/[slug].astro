---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://veramakeupvan.com");
---

<Layout
    title={`${post.data.title} | Vera Makeup Blog`}
    description={post.data.description}
    type="article"
>
    <Header />

    <main class="pt-24 bg-slate-50">
        <div class="max-w-3xl mx-auto px-6 py-16">
            <a href="/blog/" class="inline-flex items-center gap-2 text-sm uppercase tracking-widest text-taupe hover:text-deeprose transition-colors">
                <i class="bi bi-arrow-left"></i> Back to Blog
            </a>

            <div class="mt-8 mb-6 flex flex-wrap items-center gap-4 text-xs uppercase tracking-[0.25em] text-taupe font-medium">
                <span class="bg-white border border-neutral-200 rounded-sm px-3 py-1">{post.data.category}</span>
                <span>{formattedDate}</span>
            </div>

            <h1 class="font-serif text-4xl lg:text-5xl text-neutral-900 leading-tight">{post.data.title}</h1>

            <img src={post.data.coverImage} alt={post.data.coverAlt} class="w-full rounded-sm border border-neutral-200 my-10" />

            <div class="blog-prose">
                <Content />
            </div>

            <div class="mt-16 pt-8 border-t border-neutral-200 text-center">
                <p class="font-serif text-2xl text-neutral-900">Ready for your own wedding glow?</p>
                <a href="/services/#contact" class="inline-block mt-4 bg-rosegold text-white px-8 py-3.5 rounded-sm hover:bg-deeprose transition-all luxury-shadow">
                    Book a Bridal Consultation
                </a>
            </div>
        </div>
    </main>

    <Footer />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": post.data.title,
        "description": post.data.description,
        "datePublished": post.data.date.toISOString(),
        "dateModified": post.data.date.toISOString(),
        "url": canonicalURL.href,
        "author": {
            "@type": "Person",
            "name": "Vera Makeup Studio",
            "url": "https://veramakeupvan.com/about/"
        },
        "publisher": {
            "@type": "Organization",
            "name": "Vera Makeup Studio",
            "url": "https://veramakeupvan.com"
        }
    })} />
</Layout>

<style>
    .blog-prose h2 {
        font-family: 'Playfair Display', serif;
        font-size: 1.75rem;
        line-height: 1.3;
        color: #171717;
        margin-top: 3.5rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .blog-prose h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        line-height: 1.35;
        color: #171717;
        margin-top: 2.25rem;
        margin-bottom: 0.9rem;
    }

    .blog-prose p {
        color: #525252;
        line-height: 1.8;
        margin-bottom: 1.25rem;
    }

    .blog-prose strong {
        color: #171717;
        font-weight: 600;
    }

    .blog-prose a {
        color: #b76e4b;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s;
    }

    .blog-prose a:hover {
        color: #9c4f2f;
    }

    .blog-prose ul {
        list-style: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
        color: #525252;
        line-height: 1.8;
    }

    .blog-prose ol {
        list-style: decimal;
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
        color: #525252;
        line-height: 1.8;
    }

    .blog-prose li {
        margin-bottom: 0.5rem;
    }

    .blog-prose li::marker {
        color: #b76e4b;
    }

    .blog-prose blockquote {
        border-left: 3px solid #b76e4b;
        padding-left: 1.25rem;
        margin: 1.75rem 0;
        font-style: italic;
        color: #737373;
    }

    .blog-prose img {
        width: 100%;
        height: auto;
        border-radius: 0.25rem;
        margin: 2rem 0;
        border: 1px solid #e5e5e5;
    }

    .blog-prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.75rem 0;
        font-size: 0.9rem;
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 0.25rem;
        overflow: hidden;
    }

    .blog-prose th {
        background: #fafafa;
        color: #171717;
        font-weight: 600;
        text-align: left;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e5e5e5;
    }

    .blog-prose td {
        color: #525252;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: top;
    }

    .blog-prose tr:last-child td {
        border-bottom: none;
    }

    .blog-prose hr {
        border: none;
        border-top: 1px solid #e5e5e5;
        margin: 2.5rem 0;
    }
</style>
