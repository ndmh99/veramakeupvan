---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Makeup Services & Packages | Vera Makeup Studio Vancouver"
    description="Professional makeup artistry services in Vancouver, BC. Specializing in bridal makeup, editorial looks, grad makeup, and special events. View our packages."
    type="website"
>
    <!-- Service Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Professional Makeup Artistry",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Vera Makeup Studio",
        "image": "https://veramakeupvan.com/assets/images/thumbnail.png",
        "telephone": "+17789510631",
        "url": "https://veramakeupvan.com"
      },
      "areaServed": [
        "Vancouver",
        "Burnaby",
        "Richmond",
        "Surrey",
        "Metro Vancouver"
      ],
      "description": "Professional makeup artistry services specializing in bridal, editorial, and special event makeup across Metro Vancouver.",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Makeup Services Catalog",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Bridal Day-Of Hair & Makeup",
              "description": "Bespoke skin preparation, premium false lash application, long-wear setting, and veil or hair accessory placement. Complimentary early morning start."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 560.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Bridal Preview & Consultation (Trial)",
              "description": "A dedicated 2 to 2.5-hour session to design, customize, and perfect your wedding day look prior to the big day."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 280.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "6-Hour Bridal Touch-Up Package",
              "description": "Complete Bridal Day-Of Hair & Makeup with up to 6 hours of on-site touch-up and support, plus 1 extra hairstyle transition."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 800.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "10-Hour VIP Bridal Package",
              "description": "Complete Bridal Day-Of Hair & Makeup with up to 10 hours of full-day on-site touch-up and support, plus 2 extra hairstyle transitions."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 1200.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Photoshoot & Event Hair & Makeup",
              "description": "Tailored for personal portraits, engagement shoots, maternity sessions, branding photoshoots, and special galas."
            },
            "priceSpecification": {
              "@type": "PriceSpecification",
              "minPrice": 180.00,
              "maxPrice": 240.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Bridal Party & Guest Hair & Makeup",
              "description": "Full-face event makeup with false lashes and tailored hair styling for bridesmaids, mothers, and special guests."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 180.00,
              "priceCurrency": "CAD"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Groom & Men's Grooming",
              "description": "Subtle skin prep, anti-shine treatment, light concealer, and professional hair styling."
            },
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": 100.00,
              "priceCurrency": "CAD"
            }
          }
        ]
      }
    }
    </script>
    
    <Header />
    
<!-- THE SERVICE MENU -->
